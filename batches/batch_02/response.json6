{
    "test_cases": [
        {
            "id": "202602GEN-0501",
            "priority": "Critical",
            "title": "Verify delete member confirmation dialog in list view",
            "precondition": "Committee Members page is in list view with multiple members present",
            "steps": "1. Navigate to Committee Members page\n2. Switch to list view if not already active\n3. Click delete icon (trash) on a non-chair member (e.g., Alex Johnson)\n4. Observe the confirmation modal",
            "expected_result": "Modal titled 'Are you sure?' appears with trash icon, displays member name and role, shows 'Confirm' button in red and 'Cancel' button, warning message clearly states the action",
            "actual_result": "",
            "status": "Not Run",
            "qa_tester": "",
            "qa_notes": ""
        },
        {
            "id": "202602GEN-0502",
            "priority": "Critical",
            "title": "Verify successful member deletion in list view",
            "precondition": "Delete confirmation modal is displayed for a non-chair member",
            "steps": "1. Click 'Confirm' button in the delete confirmation modal\n2. Observe the page state and notification",
            "expected_result": "Modal closes, member is removed from the list, member count decreases by 1, green success notification 'Committee Chair has been successfully changed' appears at bottom, remaining members display correctly",
            "actual_result": "",
            "status": "Not Run",
            "qa_tester": "",
            "qa_notes": ""
        },
        {
            "id": "202602GEN-0503",
            "priority": "Critical",
            "title": "Verify remove committee chair workflow",
            "precondition": "At least 2 committee members exist, one designated as chair",
            "steps": "1. Navigate to Committee Members page in grid view\n2. Locate the current committee chair member card (e.g., Maria Gonzalez with 'Chair' label)\n3. Click delete icon on the chair's card\n4. Observe the confirmation modal",
            "expected_result": "Modal titled 'Remove Committee Chair' appears with trash icon, displays chair's name and role, warning states 'You'll need to assign a new chair after this action', 'Confirm' button in red and 'Cancel' button are visible",
            "actual_result": "",
            "status": "Not Run",
            "qa_tester": "",
            "qa_notes": ""
        },
        {
            "id": "202602GEN-0504",
            "priority": "Critical",
            "title": "Verify automatic new chair selection prompt after chair removal",
            "precondition": "Remove Committee Chair confirmation modal is displayed",
            "steps": "1. Click 'Confirm' button to remove current chair\n2. Observe the subsequent modal and notification",
            "expected_result": "Error notification 'Committee Member has been successfully removed. ERROR' appears at bottom, 'Select New Committee Chair' modal automatically appears, modal states 'The previous chair has been removed. Please select a new chair for your committee.', list of eligible members is displayed with their names and roles",
            "actual_result": "",
            "status": "Not Run",
            "qa_tester": "",
            "qa_notes": ""
        },
        {
            "id": "202602GEN-0505",
            "priority": "Critical",
            "title": "Verify selecting new chair from selection modal",
            "precondition": "'Select New Committee Chair' modal is displayed with list of members",
            "steps": "1. Review the list of available members (e.g., Juan dela Cruz, Liam Johnson, Ayesha Cruz, Liam Smith, Sofia Garcia)\n2. Click on a member to select (e.g., Juan dela Cruz - IT Manager)\n3. Click 'Save Changes' button",
            "expected_result": "Selected member is highlighted or shows selected state, 'Save Changes' button becomes active/enabled, modal closes after save, new chair is designated with 'Chair' label on their card, success notification appears",
            "actual_result": "",
            "status": "Not Run",
            "qa_tester": "",
            "qa_notes": ""
        },
        {
            "id": "202602GEN-0506",
            "priority": "High",
            "title": "Verify skip option in new chair selection modal",
            "precondition": "'Select New Committee Chair' modal is displayed",
            "steps": "1. Click 'Skip for now' button at bottom left of modal\n2. Observe system behavior",
            "expected_result": "Modal closes without assigning new chair, committee operates without designated chair (if allowed by system), or warning appears that chair is required, user can return later to assign chair",
            "actual_result": "",
            "status": "Not Run",
            "qa_tester": "",
            "qa_notes": ""
        },
        {
            "id": "202602GEN-0507",
            "priority": "High",
            "title": "Verify list view display of committee members",
            "precondition": "Multiple committee members exist in the system",
            "steps": "1. Navigate to Committee Members page\n2. Switch to list view using view toggle\n3. Observe the layout and information displayed",
            "expected_result": "Members display in table/list format with columns: Name, Role, Email Address, Format Actions, 'Chair' label visible for designated chair, action icons (delete, edit, Make Chair) aligned to right, pagination controls show at bottom (e.g., 'Showing 8 of 8'), all data is clearly readable",
            "actual_result": "",
            "status": "Not Run",
            "qa_tester": "",
            "qa_notes": ""
        },
        {
            "id": "202602GEN-0508",
            "priority": "Medium",
            "title": "Verify member count accuracy after chair removal and reassignment",
            "precondition": "System has 8 committee members initially",
            "steps": "1. Note initial member count (8 members)\n2. Remove the current chair\n3. Verify count shows 7 members\n4. Assign new chair from remaining members\n5. Verify final count remains 7 members",
            "expected_result": "Member count accurately reflects removal (8 → 7), count doesn't change during chair reassignment, pagination updates correctly (e.g., 'Showing 7 of 7')",
            "actual_result": "",
            "status": "Not Run",
            "qa_tester": "",
            "qa_notes": ""
        },
        {
            "id": "202602GEN-0509",
            "priority": "High",
            "title": "Verify grid view state after chair operations",
